# Server
PORT=5000
NODE_ENV=development

# MongoDB: use "memory" for the embedded dev database (no install needed),
# or a real connection string, e.g. mongodb://127.0.0.1:27017/smart_campus_complaint_db
# or mongodb+srv://<db-user>:<password>@<cluster>/smart_campus_complaint_db
MONGO_URI=memory

# Auth (use a long random value in production)
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# Cookie SameSite: lax for same-site setups, none when frontend and API are on different domains (requires HTTPS)
# COOKIE_SAMESITE=lax

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=5

# Optional: initial admin for the seed script
# SEED_ADMIN_EMAIL=admin@campus.edu
# SEED_ADMIN_PASSWORD=Admin@123

# Public URL of the React app (used in email links)
APP_URL=http://localhost:5173

# Email (optional). Without SMTP_HOST, emails are printed to the server console
# and verification/reset links are shown in the UI in development.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=IUBAT Smart Campus <no-reply@iubat.edu>

# Token lifetimes
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_DAYS=7
